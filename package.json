  },
  "browserslist": [
    "iOS >= 15",
    "Safari >= 15",
    "> 0.5%",
    "not dead"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@mdi/js": "^7.4.47",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
